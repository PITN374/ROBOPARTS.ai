# Microsoft Entra ID application registration
AZURE_TENANT_ID=replace-with-your-tenant-id
AZURE_CLIENT_ID=replace-with-your-application-client-id
AZURE_CLIENT_SECRET=configure-as-a-deployment-secret

# Mailbox authorized to send through Microsoft Graph
RFQ_FROM_EMAIL=your-authorized-sender-mailbox@pitn.ai

# Destination for every ROBOPARTS RFQ
RFQ_TO_EMAIL=powerinthenumbers@pitn.ai

# Optional: set the actual origins that host the RFQ form.
# Separate multiple origins with commas.
RFQ_ALLOWED_ORIGINS=https://roboparts.ai,https://www.roboparts.ai,https://pitn.ai,https://www.pitn.ai
